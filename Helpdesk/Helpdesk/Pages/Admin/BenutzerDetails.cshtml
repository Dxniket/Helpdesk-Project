@page
@model Helpdesk.Pages.Admin.BenutzerDetailsModel

@{
    ViewData["Title"] = "Benutzerdetails";
}

<div class="container mt-4">

    @if (!string.IsNullOrEmpty(Model.InfoMessage))
    {
        <div class="alert alert-success">
            @Model.InfoMessage
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Benutzerdetails</h2>
            <p class="text-muted mb-0">
                Benutzerinformationen
            </p>
        </div>

        <a asp-page="/Admin/AdminPortal"
           class="btn btn-outline-secondary">
            Zurück
        </a>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-lg col-md-6">

            <div class="card border-0 shadow h-100">

                <div class="card-body text-center">

                    <div class="text-muted">

                        Erstellte Tickets

                    </div>

                    <h2 class="fw-bold mt-2">

                        @Model.Statistik.ErstellteTickets

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg col-md-6">

            <div class="card border-0 shadow h-100">

                <div class="card-body text-center">

                    <div class="text-muted">

                        Offen

                    </div>

                    <h2 class="fw-bold text-primary mt-2">

                        @Model.Statistik.OffeneTickets

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg col-md-6">

            <div class="card border-0 shadow h-100">

                <div class="card-body text-center">

                    <div class="text-muted">

                        In Bearbeitung

                    </div>

                    <h2 class="fw-bold text-warning mt-2">

                        @Model.Statistik.TicketsInBearbeitung

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg col-md-6">

            <div class="card border-0 shadow h-100">

                <div class="card-body text-center">

                    <div class="text-muted">

                        Geschlossen

                    </div>

                    <h2 class="fw-bold text-secondary mt-2">

                        @Model.Statistik.GeschlosseneTickets

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg col-md-6">

            <div class="card border-0 shadow h-100">

                <div class="card-body text-center">

                    <div class="text-muted">

                        Hohe Priorität

                    </div>

                    <h2 class="fw-bold text-danger mt-2">

                        @Model.Statistik.HohePrioritaet

                    </h2>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow">

        <div class="card-header">
            <h5 class="mb-0">Benutzerdaten</h5>
        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <tr>
                    <th style="width:220px;">Benutzer-ID</th>
                    <td>@Model.Benutzer.BenutzerId</td>
                </tr>

                <tr>
                    <th>Vorname</th>
                    <td>@Model.Benutzer.Vorname</td>
                </tr>

                <tr>
                    <th>Nachname</th>
                    <td>@Model.Benutzer.Nachname</td>
                </tr>

                <tr>
                    <th>E-Mail</th>
                    <td>@Model.Benutzer.Email</td>
                </tr>

                <tr>
                    <th>Telefonnummer</th>
                    <td>@Model.Benutzer.Telefonnummer</td>
                </tr>

            </table>

            <form method="post"
                  asp-page-handler="Delete"
                  onsubmit="return confirm('Benutzer wirklich löschen?');">

                <input type="hidden"
                       name="benutzerId"
                       value="@Model.Benutzer.BenutzerId" />

                <button class="btn btn-danger">
                    Benutzer löschen
                </button>

            </form>

        </div>

    </div>

</div>