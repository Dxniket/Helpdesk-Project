@page
@model Helpdesk.Pages.AccessDeniedModel
@{
}
<div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card shadow-lg p-4 text-center" style="max-width: 460px; width: 100%; border-radius: 16px;">

        <h2 class="mb-3 text-danger">
            <i class="bi bi-shield-exclamation me-2"></i>
            Zugriff verweigert
        </h2>

        <p class="mb-4">
            Du hast nicht die erforderlichen Rechte, um diese Seite aufzurufen.
        </p>

        <a asp-page="/Index" class="btn btn-primary w-100 mb-2">
            <i class="bi bi-box-arrow-in-right me-1"></i> Zur Startseite
        </a>

        <a asp-page="/Profile/MeinProfil" class="btn btn-outline-secondary w-100">
            <i class="bi bi-house-door me-1"></i> Zurück zum Profil
        </a>

    </div>
</div>